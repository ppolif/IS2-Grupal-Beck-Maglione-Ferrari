    <!-- Parametros Fiscales de Pie -->
    <parameter name="CAE_NUMERO" class="java.lang.String"/>
    <parameter name="CAE_VENCIMIENTO" class="java.lang.String"/>

    <!-- Campos del DataSource de Items de Factura -->
    <field name="numeroItem" class="java.lang.Integer"/>
    <field name="codigo" class="java.lang.String"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="categoria" class="java.lang.String"/>
