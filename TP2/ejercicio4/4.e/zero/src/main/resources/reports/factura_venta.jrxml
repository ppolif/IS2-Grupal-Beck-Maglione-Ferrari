              name="factura_venta"
              pageWidth="595"
              pageHeight="842"
              columnWidth="535"
              leftMargin="30"
              rightMargin="30"
              topMargin="30"
              bottomMargin="30"
              uuid="c1b52a48-5251-40b9-87c2-3e7529320e6a">

    <!-- Parametros de Empresa Emisora -->
    <parameter name="EMPRESA_NOMBRE" class="java.lang.String"/>
    <parameter name="EMPRESA_RAZON_SOCIAL" class="java.lang.String"/>
    <parameter name="EMPRESA_CUIT" class="java.lang.String"/>
    <parameter name="EMPRESA_DIRECCION" class="java.lang.String"/>
    <parameter name="EMPRESA_CONDICION_IVA" class="java.lang.String"/>
    <parameter name="EMPRESA_IIBB" class="java.lang.String"/>
    <parameter name="EMPRESA_INICIO_ACT" class="java.lang.String"/>

    <!-- Parametros del Comprobante Fiscal -->
    <parameter name="FACTURA_NUMERO" class="java.lang.String"/>
    <parameter name="FACTURA_FECHA" class="java.lang.String"/>
    <parameter name="FACTURA_TIPO" class="java.lang.String"/>
    <parameter name="FACTURA_CODIGO_TIPO" class="java.lang.String"/>
    <parameter name="FORMA_PAGO" class="java.lang.String"/>

    <!-- Parametros del Cliente Receptor -->
    <parameter name="CLIENTE_NOMBRE" class="java.lang.String"/>
    <parameter name="CLIENTE_DOCUMENTO" class="java.lang.String"/>
    <parameter name="CLIENTE_DOMICILIO" class="java.lang.String"/>
