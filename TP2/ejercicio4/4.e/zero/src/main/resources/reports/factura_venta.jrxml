                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{cantidad} != null ? $F{cantidad} : 1]]></textFieldExpression>
            </textField>
