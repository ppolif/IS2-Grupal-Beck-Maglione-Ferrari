                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{numeroItem} != null ? $F{numeroItem} : $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
