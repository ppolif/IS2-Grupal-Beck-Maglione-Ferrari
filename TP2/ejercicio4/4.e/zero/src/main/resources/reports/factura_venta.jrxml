    <!-- CUERPO DE DETALLES: Cada item facturado -->
    <detail>
        <band height="20" splitType="Stretch">
            <!-- Linea tenue horizontal entre renglones -->
            <line>
                <reportElement x="0" y="19" width="535" height="1" forecolor="#E0E0E0" uuid="09f87211-1a2b-3c4d-5e6f-7a8b9c0d1e2f"/>
