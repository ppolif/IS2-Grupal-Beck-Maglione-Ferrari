# --- MySQL (Base de datos aislada blockazo_db) ---
MYSQL_ROOT_PASSWORD=cambiar_por_password_root
MYSQL_DATABASE=blockazo_db
MYSQL_USER=blockazo_user
MYSQL_PASSWORD=cambiar_por_password_db

# --- Puertos expuestos al host (aislados de integrador-2) ---
DB_PORT=3307
BACKEND_PORT=8081
FRONTEND_PORT=3005

# --- Seguridad (backend) ---
# Obligatorio: mínimo 32 caracteres aleatorios
JWT_SECRET=reemplazar_con_secreto_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRATION_MINUTES=60

# --- Configuración de aplicación ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:3005,http://localhost:5173
APP_SEED_ENABLED=true

