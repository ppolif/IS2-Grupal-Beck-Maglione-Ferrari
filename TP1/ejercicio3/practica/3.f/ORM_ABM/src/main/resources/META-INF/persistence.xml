<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="minimarketPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>org.example.Persona</class>

        <properties>
            <!-- Conexión a H2 -->
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:minimarketdb;DB_CLOSE_DELAY=-1"/> <!-- "mem" es para que la base de datos esté en RAM -->
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/> <!-- sa y la contraseña vacia son los valores por defecto para el webviewer de H2 -->

            <!-- Dialecto de Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>

            <!-- crea y actualiza las tablas a partir de los @Entity, si pones drop-create entonces cada vez que se incializa la app se dropean y crean las tablas desde cero -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- muestra la salida de las consultas SQL formateada en consola para ver que hace el ORM -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>