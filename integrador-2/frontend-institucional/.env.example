# Configuración de API
VITE_API_URL=/api/v1

# Configuración de Auth0 (Portal Clientes)
# Obtener en Auth0 Dashboard -> Applications -> Single Page Application
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_CALLBACK_URL=http://localhost:3001/login
# Obtener en Auth0 Dashboard -> Applications -> APIs -> Identifier (opcional para omitir consentimiento)
VITE_AUTH0_AUDIENCE=
