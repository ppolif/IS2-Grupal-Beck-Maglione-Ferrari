# --- MySQL ---
MYSQL_ROOT_PASSWORD=cambiar_por_password_root
MYSQL_DATABASE=dulcemayor_db
MYSQL_USER=dulcemayor_user
MYSQL_PASSWORD=cambiar_por_password_db

# --- Seguridad (backend) ---
# Obligatorio: mínimo 32 caracteres aleatorios
JWT_SECRET=reemplazar_con_secreto_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRATION_MINUTES=60

# --- Chatbot IA ---
GEMINI_API_KEY=reemplazar_con_api_key_de_gemini
GEMINI_MODEL=gemini-2.5-flash

# --- Configuración de aplicación ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
APP_SEED_ENABLED=true

